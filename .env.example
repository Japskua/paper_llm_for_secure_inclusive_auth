# Which LLM backend to use: openai | openrouter | anthropic
LLM_PROVIDER=openrouter

# ---------- OpenRouter (used for the experiment) ----------
OPENROUTER_API_KEY=sk-or-...
# Default model for all three agents. Overridden by run_batch.py --model.
OPENROUTER_MODEL=openai/gpt-5.6-terra
# Optional per-role overrides (left unset for the experiment: one model, three roles)
# OPENROUTER_TASKER_MODEL=
# OPENROUTER_CODER_MODEL=
# OPENROUTER_EVALUATOR_MODEL=
# Recommended (for OpenRouter policy/attribution; safe to omit)
OPENROUTER_REFERER=https://example.com
OPENROUTER_SITE_NAME=LLM Inclusivity Experiments

# --- Sampling configuration -------------------------------------------------
# IMPORTANT: frontier reasoning models (the whole GPT-5.x family, Claude Sonnet 5)
# do NOT expose `temperature`. They sample at a fixed internal temperature, so
# repeated runs are independent draws without any parameter being set. provider.py
# checks each model's supported_parameters and only sends temperature when the
# model accepts it; the effective setting is recorded per run in tokens_summary.json.
#
# Set this only if your chosen model supports it (e.g. x-ai/grok-4.5,
# google/gemini-3.6-flash, openai/gpt-4o). Ignored otherwise.
# LLM_TEMPERATURE=1.0
#
# Reasoning effort IS exposed and materially affects both output quality and
# token cost, so it is treated as a recorded experimental parameter.
OPENROUTER_REASONING_EFFORT=medium
#
# NOTE: no seed is ever sent. A fixed seed would suppress exactly the between-run
# variance the repeated-runs design exists to measure.

# --- Reproducibility --------------------------------------------------------
# OpenRouter may route one model id across several upstream providers with
# different quantizations. Pin the order so repeated runs don't silently span
# backends. Leave unset to accept OpenRouter's default routing.
# OPENROUTER_PROVIDER_ORDER=openai
OPENROUTER_REQUIRE_PARAMETERS=true

# Per-request timeout in seconds. Reasoning models emitting 25k+ output tokens
# routinely exceed the old 60s default; retries are handled in app/utils/io.py.
LLM_TIMEOUT_S=900

# ---------- OpenAI (direct) ----------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---------- Anthropic (direct) ----------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional pricing fallback (USD per 1M tokens) --------------------------
# Normally unnecessary: OpenRouter returns authoritative per-call cost via usage
# accounting, which already covers reasoning tokens and per-provider rates.
# Used only when the backend reports no cost.
# PRICE_INPUT_PER_1M=1.00
# PRICE_CACHED_INPUT_PER_1M=0.10
# PRICE_OUTPUT_PER_1M=6.00
