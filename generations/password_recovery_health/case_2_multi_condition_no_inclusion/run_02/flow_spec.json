{
  "variables": {
    "email": "demo@example.test",
    "new_password": "ValidPassword1!"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": "const CSRF = \"([^\"]+)\";",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "start recovery session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery token",
      "method": "POST",
      "path": "/api/recovery-request",
      "body": {
        "contact": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "token": "testToken"
      }
    },
    {
      "name": "verify recovery token",
      "method": "POST",
      "path": "/api/verify-token",
      "body": {
        "token": "${token}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mfaTestCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/verify-mfa",
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/set-password",
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/accept-privacy",
      "body": {
        "accepted": true
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid recovery token rejected",
      "method": "POST",
      "path": "/api/verify-token",
      "body": {
        "token": "invalid_recovery_token_value"
      },
      "expect_failure": true
    },
    {
      "name": "wrong MFA code rejected",
      "method": "POST",
      "path": "/api/verify-mfa",
      "body": {
        "code": "000000"
      },
      "expect_failure": true
    },
    {
      "name": "weak password rejected",
      "method": "POST",
      "path": "/api/set-password",
      "body": {
        "password": "weakpassword"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance requires true",
      "method": "POST",
      "path": "/api/accept-privacy",
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}