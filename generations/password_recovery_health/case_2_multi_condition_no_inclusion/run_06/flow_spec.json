{
  "variables": {
    "email": "any.user@example.test",
    "new_password": "StrongPass1!x"
  },
  "csrf": null,
  "steps": [
    {
      "name": "load recovery application",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "bootstrap secure session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "start recovery",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "token": "mockToken"
      }
    },
    {
      "name": "confirm token verification stage",
      "method": "GET",
      "path": "/api/recovery-status",
      "expect_json_true": "ok",
      "capture": {
        "verification_stage": "stage"
      }
    },
    {
      "name": "verify recovery token",
      "method": "POST",
      "path": "/api/verify-token",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${token}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm MFA stage",
      "method": "GET",
      "path": "/api/recovery-status",
      "expect_json_true": "ok",
      "capture": {
        "mfa_stage": "stage"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/verify-mfa",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "246810",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm password reset stage",
      "method": "GET",
      "path": "/api/recovery-status",
      "expect_json_true": "ok",
      "capture": {
        "reset_stage": "stage"
      }
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/reset-password",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm privacy stage",
      "method": "GET",
      "path": "/api/recovery-status",
      "expect_json_true": "ok",
      "capture": {
        "privacy_stage": "stage"
      }
    },
    {
      "name": "accept privacy statement",
      "method": "POST",
      "path": "/api/accept-privacy",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": true,
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm recovery completion",
      "method": "GET",
      "path": "/api/recovery-status",
      "expect_json_true": "ok",
      "capture": {
        "completion_stage": "stage"
      }
    }
  ],
  "negative_steps": [
    {
      "name": "recovery request without CSRF rejected",
      "method": "POST",
      "path": "/api/recovery",
      "body": {
        "email": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "used recovery token rejected",
      "method": "POST",
      "path": "/api/verify-token",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${token}",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong MFA code rejected",
      "method": "POST",
      "path": "/api/verify-mfa",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "000000",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "weak password rejected",
      "method": "POST",
      "path": "/api/reset-password",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "weakpassword",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance must be true",
      "method": "POST",
      "path": "/api/accept-privacy",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": false,
        "csrf": "${csrf}"
      },
      "expect_failure": true
    }
  ]
}