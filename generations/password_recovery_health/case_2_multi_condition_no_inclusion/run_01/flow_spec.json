{
  "variables": {
    "email": "any-user@example.test",
    "new_password": "Recover!Pass2025"
  },
  "seeded_credentials": null,
  "csrf": {
    "html_regex": "<meta name=\"csrf-token\" content=\"([^\"]+)\">",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "initialize recovery session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery instructions",
      "method": "POST",
      "path": "/api/recovery/request",
      "body": {
        "identifier": "${email}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "authorize local recovery factor",
      "method": "POST",
      "path": "/api/recovery/authorize-factor",
      "body": {
        "factor": "LOCAL-RECOVERY-FACTOR"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_code": "testCode"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/recovery/verify",
      "body": {
        "code": "${reset_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/recovery/reset-password",
      "body": {
        "password": "${new_password}",
        "confirmPassword": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "verify MFA security code",
      "method": "POST",
      "path": "/api/mfa/verify",
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm authenticated state",
      "method": "GET",
      "path": "/api/session/state",
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "body": {
        "accept": true
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm privacy acceptance",
      "method": "GET",
      "path": "/api/session/state",
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid recovery factor rejected",
      "method": "POST",
      "path": "/api/recovery/authorize-factor",
      "body": {
        "factor": "WRONG-RECOVERY-FACTOR"
      },
      "expect_failure": true
    },
    {
      "name": "reused recovery code rejected",
      "method": "POST",
      "path": "/api/recovery/verify",
      "body": {
        "code": "${reset_code}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "password": "Wrong!Password2025"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance required",
      "method": "POST",
      "path": "/api/privacy/accept",
      "body": {
        "accept": false
      },
      "expect_failure": true
    }
  ]
}