{
  "variables": {
    "email": "test@example.org",
    "new_password": "ValidPassword1!"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": "const CSRF = \"([a-f0-9]{64})\";",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "open recovery page and establish session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery instructions",
      "method": "POST",
      "path": "/api/recovery",
      "body": {
        "contact": "${email}"
      },
      "expect_json_true": "message",
      "capture": {
        "recovery_token": "testingToken"
      }
    },
    {
      "name": "verify recovery token",
      "method": "POST",
      "path": "/api/reset/verify",
      "body": {
        "token": "${recovery_token}"
      },
      "expect_json_true": "message",
      "capture": {
        "recovery_mfa_code": "testingMfaCode"
      }
    },
    {
      "name": "confirm recovery MFA code",
      "method": "POST",
      "path": "/api/mfa",
      "body": {
        "code": "${recovery_mfa_code}"
      },
      "expect_json_true": "message"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/password",
      "body": {
        "password": "${new_password}",
        "confirmation": "${new_password}"
      },
      "expect_json_true": "message"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "message",
      "capture": {
        "login_mfa_code": "testingMfaCode"
      }
    },
    {
      "name": "confirm sign-in MFA code",
      "method": "POST",
      "path": "/api/login/mfa",
      "body": {
        "code": "${login_mfa_code}"
      },
      "expect_json_true": "message"
    },
    {
      "name": "accept privacy statement",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "accepted": true
      },
      "expect_json_true": "message"
    },
    {
      "name": "verify completed workflow state",
      "method": "GET",
      "path": "/api/session-status",
      "expect_json_true": "privacyAccepted"
    }
  ],
  "negative_steps": [
    {
      "name": "consumed recovery token rejected",
      "method": "POST",
      "path": "/api/reset/verify",
      "body": {
        "token": "${recovery_token}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "password": "WrongPassword1!"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance requires true acknowledgement",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}