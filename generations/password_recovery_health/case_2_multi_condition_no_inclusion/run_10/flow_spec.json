{
  "variables": {
    "email": "any-contact@example.test",
    "new_password": "ValidReset!2025"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": "<meta\\s+name=\"csrf-token\"\\s+content=\"([^\"]+)\">",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "start secure recovery session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery token",
      "method": "POST",
      "path": "/api/recovery/request",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "contact": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "testResetToken"
      }
    },
    {
      "name": "verify recovery token",
      "method": "POST",
      "path": "/api/recovery/verify-token",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/recovery/password",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/recovery/mfa",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy statement",
      "method": "POST",
      "path": "/api/recovery/privacy-accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": true
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid recovery token rejected",
      "method": "POST",
      "path": "/api/recovery/verify-token",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "invalid-recovery-token"
      },
      "expect_failure": true
    },
    {
      "name": "weak password rejected",
      "method": "POST",
      "path": "/api/recovery/password",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "short"
      },
      "expect_failure": true
    },
    {
      "name": "incorrect MFA code rejected",
      "method": "POST",
      "path": "/api/recovery/mfa",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "000000"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance requires true boolean",
      "method": "POST",
      "path": "/api/recovery/privacy-accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": false
      },
      "expect_failure": true
    },
    {
      "name": "missing CSRF token rejected",
      "method": "POST",
      "path": "/api/recovery/request",
      "headers": {
        "X-CSRF-Token": ""
      },
      "body": {
        "contact": "${email}"
      },
      "expect_failure": true
    }
  ]
}