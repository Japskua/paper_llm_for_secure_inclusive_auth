{
  "variables": {
    "email": null,
    "contact": "recovery.test@example.invalid",
    "new_password": "ValidPass1!23"
  },
  "csrf": {
    "html_regex": "<meta\\s+name=\"csrf-token\"\\s+content=\"([^\"]+)\">",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "start secure recovery session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery token",
      "method": "POST",
      "path": "/api/recovery/request",
      "body": {
        "contact": "${contact}"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "testResetToken"
      }
    },
    {
      "name": "verify recovery token",
      "method": "POST",
      "path": "/api/recovery/verify-token",
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/recovery/password",
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/recovery/mfa",
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy statement",
      "method": "POST",
      "path": "/api/recovery/privacy-accept",
      "body": {
        "accepted": true
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid recovery token rejected",
      "method": "POST",
      "path": "/api/recovery/verify-token",
      "body": {
        "token": "invalid-reset-token"
      },
      "expect_failure": true
    },
    {
      "name": "weak password rejected",
      "method": "POST",
      "path": "/api/recovery/password",
      "body": {
        "password": "weakpassword"
      },
      "expect_failure": true
    },
    {
      "name": "wrong MFA code rejected",
      "method": "POST",
      "path": "/api/recovery/mfa",
      "body": {
        "code": "000000"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance requires true boolean",
      "method": "POST",
      "path": "/api/recovery/privacy-accept",
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}