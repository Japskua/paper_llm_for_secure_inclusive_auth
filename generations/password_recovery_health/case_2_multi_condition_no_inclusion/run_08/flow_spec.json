{
  "variables": {
    "email": "demo@example.com",
    "new_password": "ValidPass123!"
  },
  "csrf": {
    "html_regex": "<meta name=\"csrf-token\" content=\"([^\"]+)\">",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "start recovery session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery",
      "body": {
        "account": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "deliveryToken"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify-token",
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "save new password",
      "method": "POST",
      "path": "/api/password",
      "body": {
        "password": "${new_password}",
        "confirmPassword": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mockCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/mfa",
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "accepted": true
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm completion",
      "method": "GET",
      "path": "/api/confirmation",
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid account input rejected",
      "method": "POST",
      "path": "/api/recovery",
      "body": {
        "account": "x"
      },
      "expect_failure": true
    },
    {
      "name": "invalid recovery code rejected",
      "method": "POST",
      "path": "/api/verify-token",
      "body": {
        "token": "invalid"
      },
      "expect_failure": true
    },
    {
      "name": "weak password rejected",
      "method": "POST",
      "path": "/api/password",
      "body": {
        "password": "weakpassword",
        "confirmPassword": "weakpassword"
      },
      "expect_failure": true
    },
    {
      "name": "wrong MFA code rejected",
      "method": "POST",
      "path": "/api/mfa",
      "body": {
        "code": "000000"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance required",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}