{
  "variables": {
    "email": "patient@example.com",
    "new_password": "ValidPass1!xx"
  },
  "html_variables": {
    "csrf": "<meta name=\"csrf-token\" content=\"([^\"]+)\">"
  },
  "csrf": {
    "html_regex": "<meta name=\"csrf-token\" content=\"([^\"]+)\">",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "start recovery session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "account": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "deliveryToken"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify-token",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/password",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}",
        "confirmPassword": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mockCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/mfa",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": true
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm completed recovery",
      "method": "GET",
      "path": "/api/confirmation",
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "missing CSRF token rejected",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "account": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "invalid account format rejected",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "account": "x"
      },
      "expect_failure": true
    },
    {
      "name": "invalid recovery code rejected",
      "method": "POST",
      "path": "/api/verify-token",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "invalid_recovery_code"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance must be true",
      "method": "POST",
      "path": "/api/privacy",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}