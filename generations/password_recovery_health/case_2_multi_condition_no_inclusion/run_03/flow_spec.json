{
  "variables": {
    "email": "recovery@example.test",
    "new_password": "ValidPass1!23"
  },
  "csrf": {
    "html_regex": "CONFIG = \\{\"csrf\":\"([A-Za-z0-9_-]+)\"\\}",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "start recovery session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "prepare recovery instructions",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "contact": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "recovery_token": "recoveryToken"
      }
    },
    {
      "name": "verify recovery token",
      "method": "POST",
      "path": "/api/verify-token",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${recovery_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "replace password",
      "method": "POST",
      "path": "/api/password",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mfaCode"
      }
    },
    {
      "name": "confirm MFA sign-in",
      "method": "POST",
      "path": "/api/mfa",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accept": true
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "missing CSRF rejected",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "contact": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "invalid recovery contact rejected",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "contact": "x"
      },
      "expect_failure": true
    },
    {
      "name": "malformed recovery token rejected",
      "method": "POST",
      "path": "/api/verify-token",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "invalid"
      },
      "expect_failure": true
    },
    {
      "name": "weak replacement password rejected",
      "method": "POST",
      "path": "/api/password",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "weakpassword"
      },
      "expect_failure": true
    }
  ]
}