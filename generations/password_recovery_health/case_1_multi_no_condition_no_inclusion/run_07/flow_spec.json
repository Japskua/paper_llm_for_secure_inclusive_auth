{
  "variables": {
    "email": "recovery-test@example.com",
    "seeded_email": null,
    "initial_password": "Initial-Not-Usable-Password-42!",
    "new_password": "Recovered-Password-42!"
  },
  "csrf": {
    "html_regex": "const CSRF = \"([^\"]+)\";",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "open recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery verification",
      "method": "POST",
      "path": "/api/request-reset",
      "headers": {
        "Origin": "https://localhost:3000",
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "token": "testToken",
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "verify recovery and MFA codes",
      "method": "POST",
      "path": "/api/verify-reset",
      "headers": {
        "Origin": "https://localhost:3000",
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${token}",
        "mfaCode": "${mfa_code}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/set-password",
      "headers": {
        "Origin": "https://localhost:3000",
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/accept-privacy",
      "headers": {
        "Origin": "https://localhost:3000",
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid email rejected",
      "method": "POST",
      "path": "/api/request-reset",
      "headers": {
        "Origin": "https://localhost:3000",
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "not-an-email",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "CSRF mismatch rejected",
      "method": "POST",
      "path": "/api/request-reset",
      "headers": {
        "Origin": "https://localhost:3000",
        "Content-Type": "application/json",
        "X-CSRF-Token": "invalid-csrf-token"
      },
      "body": {
        "email": "${email}",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    }
  ]
}