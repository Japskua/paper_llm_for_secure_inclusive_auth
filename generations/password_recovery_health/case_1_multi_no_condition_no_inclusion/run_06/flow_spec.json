{
  "variables": {
    "email": "helena.recovery@hospital.test",
    "initial_password": "Initial-Clinical!2025",
    "new_password": "Recovered-Access!2026"
  },
  "csrf": {
    "html_regex": null,
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "bootstrap secure session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "csrf",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "load recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request password reset",
      "method": "POST",
      "path": "/api/reset/request",
      "body": {
        "contact": "${email}"
      },
      "expect_json_true": "mockToken",
      "capture": {
        "reset_token": "mockToken"
      }
    },
    {
      "name": "verify reset code",
      "method": "POST",
      "path": "/api/reset/verify",
      "body": {
        "token": "${reset_token}"
      }
    },
    {
      "name": "save new password",
      "method": "POST",
      "path": "/api/reset/confirm",
      "body": {
        "token": "${reset_token}",
        "password": "${new_password}"
      },
      "expect_json_true": "mockMfaCode",
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "complete reset MFA",
      "method": "POST",
      "path": "/api/mfa/verify",
      "body": {
        "code": "${mfa_code}"
      }
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "body": {}
    },
    {
      "name": "sign in with recovered password",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "mockMfaCode",
      "capture": {
        "login_mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "complete sign-in MFA",
      "method": "POST",
      "path": "/api/mfa/verify",
      "body": {
        "code": "${login_mfa_code}"
      }
    }
  ],
  "negative_steps": [
    {
      "name": "invalid reset code rejected",
      "method": "POST",
      "path": "/api/reset/verify",
      "body": {
        "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      },
      "expect_failure": true
    },
    {
      "name": "weak replacement password rejected",
      "method": "POST",
      "path": "/api/reset/confirm",
      "body": {
        "token": "${reset_token}",
        "password": "short"
      },
      "expect_failure": true
    },
    {
      "name": "previous password rejected after reset",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "password": "${initial_password}"
      },
      "expect_failure": true
    },
    {
      "name": "invalid CSRF header rejected",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "X-CSRF-Token": "invalid"
      },
      "body": {},
      "expect_failure": true
    }
  ]
}