{
  "variables": {
    "email": "local-recovery-demo",
    "new_password": "ValidPassw0rd!"
  },
  "csrf": null,
  "steps": [
    {
      "name": "Load recovery page and establish session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "Get session CSRF token",
      "method": "GET",
      "path": "/api/session",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "Request mock recovery token",
      "method": "POST",
      "path": "/api/recovery/request",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "identifier": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "recovery_token": "mockDeliveryToken"
      }
    },
    {
      "name": "Verify recovery token",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${recovery_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "Refresh verified session",
      "method": "GET",
      "path": "/api/session",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "Set new password",
      "method": "POST",
      "path": "/api/recovery/reset-password",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "Refresh MFA-pending session",
      "method": "GET",
      "path": "/api/session",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "Verify MFA code",
      "method": "POST",
      "path": "/api/mfa/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "Refresh authenticated session",
      "method": "GET",
      "path": "/api/session",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "Accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "Refresh privacy-accepted session",
      "method": "GET",
      "path": "/api/session",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "Confirm appointment request",
      "method": "POST",
      "path": "/api/appointment/confirm",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "Refresh confirmed session",
      "method": "GET",
      "path": "/api/session",
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "Recovery request without CSRF is rejected",
      "method": "POST",
      "path": "/api/recovery/request",
      "body": {
        "identifier": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "Reused recovery token is rejected",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${recovery_token}"
      },
      "expect_failure": true
    },
    {
      "name": "Password reset without current recovery authorization is rejected",
      "method": "POST",
      "path": "/api/recovery/reset-password",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_failure": true
    }
  ]
}