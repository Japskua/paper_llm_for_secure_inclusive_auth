{
  "variables": {
    "email": "helena@example.test",
    "new_password": "ValidPass123!"
  },
  "csrf": null,
  "steps": [
    {
      "name": "load recovery portal",
      "method": "GET",
      "path": "/",
      "expect_status": 200
    },
    {
      "name": "bootstrap secure session",
      "method": "GET",
      "path": "/api/bootstrap",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "request reset instructions",
      "method": "POST",
      "path": "/api/reset-request",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}"
      },
      "expect_json_true": "message",
      "capture": {
        "reset_token": "mockDeliveryToken"
      }
    },
    {
      "name": "validate reset code",
      "method": "POST",
      "path": "/api/reset-validate",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "message"
    },
    {
      "name": "update password",
      "method": "POST",
      "path": "/api/password-update",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}",
        "password": "${new_password}"
      },
      "expect_json_true": "message",
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/mfa-verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "message"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy-accept",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": true
      },
      "expect_json_true": "message"
    },
    {
      "name": "confirm appointment request",
      "method": "POST",
      "path": "/api/appointment-confirm",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "message"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid CSRF token rejected",
      "method": "POST",
      "path": "/api/reset-request",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}-invalid"
      },
      "body": {
        "email": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "reused reset token rejected",
      "method": "POST",
      "path": "/api/reset-validate",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance requires true",
      "method": "POST",
      "path": "/api/privacy-accept",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}