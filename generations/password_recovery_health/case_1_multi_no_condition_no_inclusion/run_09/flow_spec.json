{
  "variables": {
    "email": "helena@example.test",
    "new_password": "SecurePass1!23"
  },
  "html_variables": {},
  "csrf": {
    "endpoint": "/api/bootstrap",
    "field": "x-csrf-token",
    "in": "header"
  },
  "steps": [
    {
      "name": "load recovery portal",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "establish secure session",
      "method": "GET",
      "path": "/api/bootstrap",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "request reset instructions",
      "method": "POST",
      "path": "/api/reset-request",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {
        "email": "${email}"
      },
      "capture": {
        "reset_token": "mockDeliveryToken"
      }
    },
    {
      "name": "validate reset code",
      "method": "POST",
      "path": "/api/reset-validate",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      }
    },
    {
      "name": "update password",
      "method": "POST",
      "path": "/api/password-update",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}",
        "password": "${new_password}"
      },
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/mfa-verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      }
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy-accept",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {
        "accepted": true
      }
    },
    {
      "name": "confirm appointment request",
      "method": "POST",
      "path": "/api/appointment-confirm",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {}
    }
  ],
  "negative_steps": [
    {
      "name": "reset request without CSRF rejected",
      "method": "POST",
      "path": "/api/reset-request",
      "headers": {
        "Origin": "https://localhost:3000"
      },
      "body": {
        "email": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "invalid reset code rejected",
      "method": "POST",
      "path": "/api/reset-validate",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {
        "token": "not-the-issued-reset-token"
      },
      "expect_failure": true
    },
    {
      "name": "weak password rejected",
      "method": "POST",
      "path": "/api/password-update",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}",
        "password": "weakpassword"
      },
      "expect_failure": true
    },
    {
      "name": "incorrect MFA code rejected",
      "method": "POST",
      "path": "/api/mfa-verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {
        "code": "000000"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance requires true",
      "method": "POST",
      "path": "/api/privacy-accept",
      "headers": {
        "Origin": "https://localhost:3000",
        "x-csrf-token": "${csrf}"
      },
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}