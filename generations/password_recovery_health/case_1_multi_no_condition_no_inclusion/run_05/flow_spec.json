{
  "variables": {
    "email": "helena@hospital.test",
    "initial_password": "Initial!Passw0rd2025",
    "new_password": "Renewed!Passw0rd2025"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": "const csrf = \"([^\"]+)\";",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "open recovery page and establish session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/reset-request",
      "body": {
        "email": "${email}"
      },
      "capture": {
        "reset_token": "mockToken"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify-reset",
      "body": {
        "token": "${reset_token}"
      },
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/verify-mfa",
      "body": {
        "code": "${mfa_code}"
      }
    },
    {
      "name": "update password",
      "method": "POST",
      "path": "/api/update-password",
      "body": {
        "password": "${new_password}"
      }
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "email": "${email}",
        "password": "${new_password}"
      }
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/accept-privacy",
      "body": {
        "accepted": true
      }
    },
    {
      "name": "check authorized portal access",
      "method": "POST",
      "path": "/api/portal-check",
      "body": {}
    },
    {
      "name": "sign out",
      "method": "POST",
      "path": "/api/logout",
      "body": {}
    }
  ],
  "negative_steps": [
    {
      "name": "old password rejected after reset",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "email": "${email}",
        "password": "${initial_password}"
      },
      "expect_failure": true
    },
    {
      "name": "portal access rejected after logout",
      "method": "POST",
      "path": "/api/portal-check",
      "body": {},
      "expect_failure": true
    },
    {
      "name": "privacy acceptance rejected when signed out",
      "method": "POST",
      "path": "/api/accept-privacy",
      "body": {
        "accepted": true
      },
      "expect_failure": true
    },
    {
      "name": "invalid CSRF token rejected",
      "method": "POST",
      "path": "/api/reset-request",
      "headers": {
        "X-CSRF-Token": "invalid-csrf-token"
      },
      "body": {
        "email": "${email}"
      },
      "expect_failure": true
    }
  ]
}