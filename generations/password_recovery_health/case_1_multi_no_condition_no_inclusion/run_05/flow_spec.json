{
  "variables": {
    "email": "helena@hospital.test",
    "new_password": "Recovered!Passw0rd2025"
  },
  "csrf": {
    "html_regex": "const csrf = \"([^\"]+)\";",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "Load recovery page and establish session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "Request password recovery",
      "method": "POST",
      "path": "/api/reset-request",
      "body": {
        "email": "${email}"
      },
      "capture": {
        "recovery_token": "mockToken"
      }
    },
    {
      "name": "Verify recovery token",
      "method": "POST",
      "path": "/api/verify-reset",
      "body": {
        "token": "${recovery_token}"
      },
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "Verify MFA code",
      "method": "POST",
      "path": "/api/verify-mfa",
      "body": {
        "code": "${mfa_code}"
      }
    },
    {
      "name": "Set new password",
      "method": "POST",
      "path": "/api/update-password",
      "body": {
        "password": "${new_password}"
      }
    },
    {
      "name": "Sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "email": "${email}",
        "password": "${new_password}"
      }
    },
    {
      "name": "Accept privacy conditions",
      "method": "POST",
      "path": "/api/accept-privacy",
      "body": {
        "accepted": true
      }
    },
    {
      "name": "Confirm portal access",
      "method": "POST",
      "path": "/api/portal-check",
      "body": {}
    },
    {
      "name": "Sign out",
      "method": "POST",
      "path": "/api/logout",
      "body": {}
    }
  ],
  "negative_steps": [
    {
      "name": "Original password rejected after reset",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "email": "${email}",
        "password": "Initial!Passw0rd2025"
      },
      "expect_failure": true
    },
    {
      "name": "Privacy acceptance rejected after logout",
      "method": "POST",
      "path": "/api/accept-privacy",
      "body": {
        "accepted": true
      },
      "expect_failure": true
    },
    {
      "name": "Portal access rejected after logout",
      "method": "POST",
      "path": "/api/portal-check",
      "body": {},
      "expect_failure": true
    }
  ]
}