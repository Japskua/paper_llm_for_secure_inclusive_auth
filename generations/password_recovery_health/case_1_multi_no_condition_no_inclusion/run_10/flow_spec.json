{
  "variables": {
    "email": "demo-account",
    "new_password": "ValidPass123!"
  },
  "csrf": {
    "html_regex": "const CSRF = \"([^\"]+)\";",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "load recovery page and establish session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request reset code",
      "method": "POST",
      "path": "/api/reset-request",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "identifier": "${email}"
      },
      "capture": {
        "token": "testToken"
      }
    },
    {
      "name": "verify reset code",
      "method": "POST",
      "path": "/api/reset-verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${token}"
      }
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/reset-complete",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "capture": {
        "mfa_code": "mfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/mfa-verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      }
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy-accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": true
      }
    }
  ],
  "negative_steps": [
    {
      "name": "missing CSRF token rejected",
      "method": "POST",
      "path": "/api/reset-request",
      "body": {
        "identifier": "demo-account"
      },
      "expect_failure": true
    },
    {
      "name": "invalid reset code rejected",
      "method": "POST",
      "path": "/api/reset-verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "not-a-valid-reset-token"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance requires true",
      "method": "POST",
      "path": "/api/privacy-accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}