{
  "variables": {
    "email": "helena.patient@hospital.test",
    "password": "Initial-Demo-Password-Only!",
    "new_password": "NewSecure!Pass9"
  },
  "csrf": {
    "html_regex": null,
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "start secure session and obtain CSRF token",
      "method": "GET",
      "path": "/api/session",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "load recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery instructions",
      "method": "POST",
      "path": "/api/reset-request",
      "body": {
        "identifier": "${email}"
      },
      "capture": {
        "reset_token": "testToken"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/reset-verify",
      "body": {
        "token": "${reset_token}"
      },
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "confirm MFA code",
      "method": "POST",
      "path": "/api/mfa-verify",
      "body": {
        "code": "${mfa_code}"
      }
    },
    {
      "name": "update password",
      "method": "POST",
      "path": "/api/password-update",
      "body": {
        "password": "${new_password}"
      }
    }
  ],
  "negative_steps": [
    {
      "name": "invalid recovery code rejected",
      "method": "POST",
      "path": "/api/reset-verify",
      "body": {
        "token": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect_failure": true
    },
    {
      "name": "MFA without recovery verification rejected",
      "method": "POST",
      "path": "/api/mfa-verify",
      "body": {
        "code": "246810"
      },
      "expect_failure": true
    },
    {
      "name": "password update without active recovery rejected",
      "method": "POST",
      "path": "/api/password-update",
      "body": {
        "password": "${new_password}"
      },
      "expect_failure": true
    }
  ]
}