{
  "variables": {
    "email": "patient@example.com",
    "new_password": "ValidPassword1!"
  },
  "csrf": {
    "html_regex": "const csrf = \"([^\"]+)\";",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "open recovery page and establish session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery instructions",
      "method": "POST",
      "path": "/api/recovery-request",
      "body": {
        "identifier": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "token": "mockToken"
      }
    },
    {
      "name": "open simulated verification link",
      "method": "GET",
      "path": "/verify?token=${token}"
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify-token",
      "body": {
        "token": "${token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/reset-password",
      "body": {
        "password": "${new_password}",
        "confirm": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "confirm MFA code",
      "method": "POST",
      "path": "/api/verify-mfa",
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/accept-privacy",
      "body": {
        "accepted": true
      },
      "expect_json_true": "ok"
    },
    {
      "name": "request medication review appointment",
      "method": "POST",
      "path": "/api/request-appointment",
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid recovery identifier rejected",
      "method": "POST",
      "path": "/api/recovery-request",
      "body": {
        "identifier": "x"
      },
      "expect_failure": true
    },
    {
      "name": "invalid recovery code rejected",
      "method": "POST",
      "path": "/api/verify-token",
      "body": {
        "token": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect_failure": true
    },
    {
      "name": "weak password rejected",
      "method": "POST",
      "path": "/api/reset-password",
      "body": {
        "password": "weakpassword",
        "confirm": "weakpassword"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance required",
      "method": "POST",
      "path": "/api/accept-privacy",
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}