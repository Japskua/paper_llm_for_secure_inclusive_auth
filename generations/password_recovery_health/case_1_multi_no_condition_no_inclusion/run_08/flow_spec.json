{
  "variables": {
    "email": "patient@example.com",
    "new_password": "ValidPass1!xx"
  },
  "csrf": {
    "html_regex": "const csrf=\"([a-f0-9]+)\"",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "open recovery page and establish session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery token",
      "method": "POST",
      "path": "/api/recovery",
      "body": {
        "email": "${email}"
      },
      "capture": {
        "token": "mockToken"
      }
    },
    {
      "name": "verify recovery token",
      "method": "POST",
      "path": "/api/verify",
      "body": {
        "token": "${token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/reset",
      "body": {
        "password": "${new_password}",
        "confirmation": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "complete MFA sign-in",
      "method": "POST",
      "path": "/api/mfa",
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "accepted": true
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid recovery email rejected",
      "method": "POST",
      "path": "/api/recovery",
      "body": {
        "email": "not-an-email"
      },
      "expect_failure": true
    },
    {
      "name": "invalid reset token rejected",
      "method": "POST",
      "path": "/api/verify",
      "body": {
        "token": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect_failure": true
    },
    {
      "name": "weak password rejected",
      "method": "POST",
      "path": "/api/reset",
      "body": {
        "password": "weakpassword",
        "confirmation": "weakpassword"
      },
      "expect_failure": true
    },
    {
      "name": "wrong MFA code rejected",
      "method": "POST",
      "path": "/api/mfa",
      "body": {
        "code": "000000"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance required",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}