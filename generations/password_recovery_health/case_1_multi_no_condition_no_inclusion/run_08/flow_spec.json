{
  "variables": {
    "email": "patient@example.com",
    "new_password": "NewPassword1!"
  },
  "csrf": {
    "html_regex": "const csrf=\"([^\"]+)\"",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "open recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request reset token",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}"
      },
      "capture": {
        "reset_token": "mockToken"
      }
    },
    {
      "name": "verify reset token",
      "method": "POST",
      "path": "/api/verify",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/reset",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}",
        "confirmation": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/mfa",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": true
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "missing CSRF token rejected",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "invalid email rejected",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "not-an-email"
      },
      "expect_failure": true
    },
    {
      "name": "invalid reset token rejected",
      "method": "POST",
      "path": "/api/verify",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "not-a-token"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance required",
      "method": "POST",
      "path": "/api/privacy",
      "headers": {
        "Content-Type": "application/json",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accepted": false
      },
      "expect_failure": true
    }
  ]
}