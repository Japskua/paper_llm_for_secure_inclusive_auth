{
  "variables": {
    "email": "any-nonempty@example.test",
    "new_password": "Violet7!Cedar",
    "origin": "https://localhost:3000"
  },
  "csrf": {
    "html_regex": "const csrf = \"([a-f0-9]{64})\";",
    "field": "csrf",
    "in": "body"
  },
  "steps": [
    {
      "name": "open recovery page and establish session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "RecoverySPA",
        "Origin": "${origin}"
      },
      "body": {
        "account": "${email}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "token": "testToken"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify-reset",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "RecoverySPA",
        "Origin": "${origin}"
      },
      "body": {
        "token": "${token}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "verify MFA security code",
      "method": "POST",
      "path": "/api/verify-mfa",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "RecoverySPA",
        "Origin": "${origin}"
      },
      "body": {
        "code": "${mfa_code}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "save new password",
      "method": "POST",
      "path": "/api/password",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "RecoverySPA",
        "Origin": "${origin}"
      },
      "body": {
        "password": "${new_password}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "RecoverySPA",
        "Origin": "${origin}"
      },
      "body": {
        "accepted": true,
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "empty account reference rejected",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "RecoverySPA",
        "Origin": "${origin}"
      },
      "body": {
        "account": "",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "reused recovery code rejected",
      "method": "POST",
      "path": "/api/verify-reset",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "RecoverySPA",
        "Origin": "${origin}"
      },
      "body": {
        "token": "${token}",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "incorrect MFA code rejected",
      "method": "POST",
      "path": "/api/verify-mfa",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "RecoverySPA",
        "Origin": "${origin}"
      },
      "body": {
        "code": "000000",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "missing CSRF token rejected",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "Content-Type": "application/json",
        "X-Requested-With": "RecoverySPA",
        "Origin": "${origin}"
      },
      "body": {
        "account": "${email}"
      },
      "expect_failure": true
    }
  ]
}