{
  "variables": {
    "email": "demo@example.test",
    "new_password": "N0rth!River2025"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": "const csrf = \"([a-f0-9]+)\";",
    "field": "csrf",
    "in": "body"
  },
  "steps": [
    {
      "name": "initialize recovery session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery",
      "body": {
        "account": "${email}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "testToken"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify-reset",
      "body": {
        "token": "${reset_token}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/verify-mfa",
      "body": {
        "code": "${mfa_code}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/password",
      "body": {
        "password": "${new_password}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "accepted": true,
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "missing CSRF rejected",
      "method": "POST",
      "path": "/api/recovery",
      "body": {
        "account": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "reused recovery code rejected",
      "method": "POST",
      "path": "/api/verify-reset",
      "body": {
        "token": "${reset_token}",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong MFA code rejected",
      "method": "POST",
      "path": "/api/verify-mfa",
      "body": {
        "code": "000000",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "duplicate password update rejected",
      "method": "POST",
      "path": "/api/password",
      "body": {
        "password": "${new_password}",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance false rejected",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "accepted": false,
        "csrf": "${csrf}"
      },
      "expect_failure": true
    }
  ]
}