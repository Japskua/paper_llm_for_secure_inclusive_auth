{
  "variables": {
    "email": "helena@example.com",
    "new_password": "NewSecure!Pass9",
    "origin": "https://localhost:3000"
  },
  "csrf": {
    "html_regex": "const\\s+csrf=\"([^\"]+)\"",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "open secure recovery portal",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery instruction",
      "method": "POST",
      "path": "/api/recovery/request",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "identifier": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "testValue",
        "recovery_identity": "testIdentityValue"
      }
    },
    {
      "name": "confirm reset token",
      "method": "POST",
      "path": "/api/recovery/instruction",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "value": "${reset_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm recovery identity",
      "method": "POST",
      "path": "/api/recovery/identity",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "value": "${recovery_identity}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "save new password",
      "method": "POST",
      "path": "/api/recovery/password",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}",
        "confirmPassword": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "identifier": "${email}",
        "password": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "testMfaCode",
        "possession_value": "testPossessionValue"
      }
    },
    {
      "name": "confirm MFA code",
      "method": "POST",
      "path": "/api/mfa/code",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm possession value",
      "method": "POST",
      "path": "/api/mfa/possession",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "value": "${possession_value}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "confirm appointment request",
      "method": "POST",
      "path": "/api/appointment",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "verify completed state",
      "method": "GET",
      "path": "/api/state",
      "expect_json_true": "appointmentBooked"
    }
  ],
  "negative_steps": [
    {
      "name": "reject request without CSRF token",
      "method": "POST",
      "path": "/api/recovery/request",
      "headers": {
        "Origin": "${origin}"
      },
      "body": {
        "identifier": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "reject wrong sign-in password",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "identifier": "${email}",
        "password": "WrongPassword!9"
      },
      "expect_failure": true
    },
    {
      "name": "reject replayed used reset token",
      "method": "POST",
      "path": "/api/recovery/instruction",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "value": "${reset_token}"
      },
      "expect_failure": true
    }
  ]
}