{
  "variables": {
    "email": "helena@example.com",
    "new_password": "ResetPass1!2025"
  },
  "csrf": null,
  "steps": [
    {
      "name": "open recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "load session state and CSRF token",
      "method": "GET",
      "path": "/api/state",
      "expect_json_true": "stage",
      "capture": {
        "csrf_token": "csrf"
      }
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery-request",
      "headers": {
        "X-CSRF-Token": "${csrf_token}"
      },
      "body": {
        "identifier": "${email}"
      },
      "expect_json_true": "stage",
      "capture": {
        "manual_recovery_code": "manualRecoveryCode",
        "verification_path": "verificationPath"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify",
      "headers": {
        "X-CSRF-Token": "${csrf_token}"
      },
      "body": {
        "code": "${manual_recovery_code}"
      },
      "expect_json_true": "stage",
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "confirm MFA code",
      "method": "POST",
      "path": "/api/mfa",
      "headers": {
        "X-CSRF-Token": "${csrf_token}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "stage"
    },
    {
      "name": "change password",
      "method": "POST",
      "path": "/api/password-change",
      "headers": {
        "X-CSRF-Token": "${csrf_token}"
      },
      "body": {
        "password": "${new_password}",
        "repeat": "${new_password}"
      },
      "expect_json_true": "stage"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "X-CSRF-Token": "${csrf_token}"
      },
      "body": {
        "identifier": "${email}",
        "password": "${new_password}"
      },
      "expect_json_true": "authenticated"
    },
    {
      "name": "confirm privacy conditions",
      "method": "POST",
      "path": "/api/privacy-confirm",
      "headers": {
        "X-CSRF-Token": "${csrf_token}"
      },
      "body": {},
      "expect_json_true": "privacyAccepted"
    }
  ],
  "negative_steps": [
    {
      "name": "recovery request without CSRF rejected",
      "method": "POST",
      "path": "/api/recovery-request",
      "body": {
        "identifier": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "invalid identifier rejected",
      "method": "POST",
      "path": "/api/recovery-request",
      "headers": {
        "X-CSRF-Token": "${csrf_token}"
      },
      "body": {
        "identifier": "!!"
      },
      "expect_failure": true
    },
    {
      "name": "reused recovery code rejected",
      "method": "POST",
      "path": "/api/verify",
      "headers": {
        "X-CSRF-Token": "${csrf_token}"
      },
      "body": {
        "code": "${manual_recovery_code}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "X-CSRF-Token": "${csrf_token}"
      },
      "body": {
        "identifier": "${email}",
        "password": "WrongPassword1!"
      },
      "expect_failure": true
    }
  ]
}