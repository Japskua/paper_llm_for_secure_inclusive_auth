{
  "variables": {
    "email": "helena@hospital.test",
    "password": "Welcome!2025Heart",
    "new_password": "Recovered!2026Pass"
  },
  "csrf": {
    "html_regex": "<meta name=\"csrf-token\" content=\"([^\"]+)\">",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "open recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "load initial state",
      "method": "GET",
      "path": "/api/state",
      "expect_json_true": "ok"
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery-request",
      "body": {
        "identifier": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "recovery_token": "testToken"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/recovery-verify",
      "body": {
        "code": "${recovery_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "replace password",
      "method": "POST",
      "path": "/api/password",
      "body": {
        "password": "${new_password}",
        "confirmation": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign in with replaced password",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "identifier": "${email}",
        "password": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/mfa-verify",
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy-accept",
      "body": {
        "accept": true
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm completed state",
      "method": "GET",
      "path": "/api/state",
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "identifier": "${email}",
        "password": "WrongPassword!9"
      },
      "expect_failure": true
    },
    {
      "name": "reused recovery code rejected",
      "method": "POST",
      "path": "/api/recovery-verify",
      "body": {
        "code": "${recovery_token}"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance required",
      "method": "POST",
      "path": "/api/privacy-accept",
      "body": {
        "accept": false
      },
      "expect_failure": true
    },
    {
      "name": "MFA verification without pending sign-in rejected",
      "method": "POST",
      "path": "/api/mfa-verify",
      "body": {
        "code": "${mfa_code}"
      },
      "expect_failure": true
    }
  ]
}