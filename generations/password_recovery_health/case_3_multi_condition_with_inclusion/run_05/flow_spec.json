{
  "variables": {
    "email": "helena.demo@hospital.test",
    "password": "password",
    "new_password": "NewPassword!2025",
    "mfa_code": "246810"
  },
  "csrf": {
    "html_regex": null,
    "field": "X-CSRF-Token",
    "in": "header",
    "endpoint": "/api/status",
    "response_field": "csrf"
  },
  "steps": [
    {
      "name": "get recovery status and CSRF token",
      "method": "GET",
      "path": "/api/status",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "load recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "identifier": "${email}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "open simulated recovery delivery",
      "method": "POST",
      "path": "/api/demo/recovery-code",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "token": "mockRecoveryCode"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "prepare password reset approval",
      "method": "POST",
      "path": "/api/recovery/replacement-grant",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "grant": "resetGrant"
      }
    },
    {
      "name": "save new password",
      "method": "POST",
      "path": "/api/password",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}",
        "confirm": "${new_password}",
        "grant": "${grant}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mockMfaCode"
      }
    },
    {
      "name": "confirm MFA code",
      "method": "POST",
      "path": "/api/mfa",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "missing CSRF token rejected",
      "method": "POST",
      "path": "/api/recovery",
      "body": {
        "identifier": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "replayed recovery code rejected",
      "method": "POST",
      "path": "/api/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${token}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "identifier": "${email}",
        "password": "DefinitelyWrong!2025"
      },
      "expect_failure": true
    },
    {
      "name": "invalid recovery identifier rejected",
      "method": "POST",
      "path": "/api/recovery",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "identifier": "x"
      },
      "expect_failure": true
    }
  ]
}