{
  "variables": {
    "email": "helena@example.test",
    "seeded_password": "password",
    "new_password": "Recovered!Pass9"
  },
  "csrf": {
    "html_regex": "csrf\\s*=\\s*d\\.(csrf)",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "bootstrap secure session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery/initiate",
      "body": {
        "email": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "token": "testDeliveryToken"
      }
    },
    {
      "name": "confirm recovery token",
      "method": "POST",
      "path": "/api/recovery/verify-token",
      "body": {
        "token": "${token}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "complete safety check",
      "method": "POST",
      "path": "/api/recovery/verify-mfa",
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "save new password",
      "method": "POST",
      "path": "/api/recovery/password-update",
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/authenticate",
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "body": {
        "accept": true
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "consumed recovery token rejected",
      "method": "POST",
      "path": "/api/recovery/verify-token",
      "body": {
        "token": "${token}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/authenticate",
      "body": {
        "password": "WrongPassword!9"
      },
      "expect_failure": true
    }
  ]
}