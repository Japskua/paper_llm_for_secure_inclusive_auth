{
  "variables": {
    "email": "helena@example.test",
    "new_password": "SecureNew!2025"
  },
  "csrf": null,
  "steps": [
    {
      "name": "open recovery page and establish session",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "bootstrap secure session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery/initiate",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "testDeliveryToken"
      }
    },
    {
      "name": "confirm recovery token",
      "method": "POST",
      "path": "/api/recovery/verify-token",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "testMfaCode"
      }
    },
    {
      "name": "complete MFA safety check",
      "method": "POST",
      "path": "/api/recovery/verify-mfa",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "save new password",
      "method": "POST",
      "path": "/api/recovery/password-update",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/authenticate",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accept": true
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "reused recovery token rejected",
      "method": "POST",
      "path": "/api/recovery/verify-token",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/authenticate",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "WrongPassword!2025"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance must be confirmed",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "accept": false
      },
      "expect_failure": true
    }
  ]
}