{
  "variables": {
    "email": "helena.patient@hospital.test",
    "new_password": "NewPassword1!"
  },
  "csrf": null,
  "steps": [
    {
      "name": "load recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "bootstrap recovery session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "check initial session status",
      "method": "GET",
      "path": "/api/status",
      "expect_json_true": "ok"
    },
    {
      "name": "start password recovery",
      "method": "POST",
      "path": "/api/recovery/start",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "authorization_secret": "authorizationSecret"
      }
    },
    {
      "name": "confirm approved channel",
      "method": "POST",
      "path": "/api/recovery/channel",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${authorization_secret}"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "token"
      }
    },
    {
      "name": "open simulated recovery link",
      "method": "GET",
      "path": "/recovery/verify?token=${reset_token}"
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/recovery/password",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}",
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mfaCode"
      }
    },
    {
      "name": "complete MFA",
      "method": "POST",
      "path": "/api/mfa",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy statement",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "recovery start without CSRF rejected",
      "method": "POST",
      "path": "/api/recovery/start",
      "headers": {
        "Origin": "https://localhost:3000"
      },
      "body": {
        "email": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong approved channel secret rejected",
      "method": "POST",
      "path": "/api/recovery/channel",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      },
      "expect_failure": true
    },
    {
      "name": "wrong recovery token rejected",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
      },
      "expect_failure": true
    },
    {
      "name": "weak new password rejected",
      "method": "POST",
      "path": "/api/recovery/password",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}",
        "password": "short"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "NotTheNewPassword1!"
      },
      "expect_failure": true
    },
    {
      "name": "wrong MFA code rejected",
      "method": "POST",
      "path": "/api/mfa",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "000000"
      },
      "expect_failure": true
    }
  ]
}