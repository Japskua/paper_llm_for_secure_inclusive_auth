{
  "variables": {
    "origin": "https://localhost:3000",
    "email": "helena.patient@hospital.test",
    "new_password": "ResetPass!2025"
  },
  "csrf": null,
  "steps": [
    {
      "name": "load recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "bootstrap recovery session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "read initial recovery status",
      "method": "GET",
      "path": "/api/status",
      "expect_json_true": "ok"
    },
    {
      "name": "start password recovery",
      "method": "POST",
      "path": "/api/recovery/start",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}"
      },
      "expect_json_true": "ok",
      "capture": {
        "authorization_secret": "authorizationSecret"
      }
    },
    {
      "name": "confirm approved channel",
      "method": "POST",
      "path": "/api/recovery/channel",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${authorization_secret}"
      },
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "token"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "save new password",
      "method": "POST",
      "path": "/api/recovery/password",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}",
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "${new_password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "mfaCode"
      }
    },
    {
      "name": "verify MFA code",
      "method": "POST",
      "path": "/api/mfa",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy statement",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "missing CSRF token rejected",
      "method": "POST",
      "path": "/api/recovery/start",
      "headers": {
        "Origin": "${origin}"
      },
      "body": {
        "email": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "weak replacement password rejected",
      "method": "POST",
      "path": "/api/recovery/password",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}",
        "password": "short"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "WrongPass!2025"
      },
      "expect_failure": true
    },
    {
      "name": "wrong MFA code rejected",
      "method": "POST",
      "path": "/api/mfa",
      "headers": {
        "Origin": "${origin}",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "000000"
      },
      "expect_failure": true
    }
  ]
}