{
  "variables": {
    "email": null,
    "new_password": "SecurePass123!"
  },
  "html_variables": {
    "recovery_reference": "id\\.value=\"(practice-[a-z0-9_-]+)\""
  },
  "csrf": {
    "html_regex": null,
    "field": "x-csrf-token",
    "in": "header"
  },
  "steps": [
    {
      "name": "open recovery portal",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "start secure session",
      "method": "GET",
      "path": "/api/session?route=recover",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery/initiate",
      "body": {
        "identifier": "${recovery_reference}"
      },
      "capture": {
        "recovery_token": "mockToken"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/recovery/verify",
      "body": {
        "token": "${recovery_token}"
      }
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/recovery/reset",
      "body": {
        "password": "${new_password}",
        "confirm": "${new_password}"
      },
      "capture": {
        "mfa_code": "mockCode"
      }
    },
    {
      "name": "confirm reset MFA",
      "method": "POST",
      "path": "/api/mfa/verify",
      "body": {
        "code": "${mfa_code}"
      }
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "body": {}
    },
    {
      "name": "confirm appointment request",
      "method": "POST",
      "path": "/api/appointment/confirm",
      "body": {}
    }
  ],
  "negative_steps": [
    {
      "name": "invalid recovery reference rejected",
      "method": "POST",
      "path": "/api/recovery/initiate",
      "body": {
        "identifier": "!"
      },
      "expect_failure": true
    },
    {
      "name": "used recovery token rejected",
      "method": "POST",
      "path": "/api/recovery/verify",
      "body": {
        "token": "${recovery_token}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "identifier": "${recovery_reference}",
        "password": "WrongPassword123!"
      },
      "expect_failure": true
    }
  ]
}