{
  "variables": {
    "email": "helena.demo@hospital.test",
    "new_password": "ResetPass!2025"
  },
  "csrf": null,
  "steps": [
    {
      "name": "load recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "create session and obtain CSRF token",
      "method": "GET",
      "path": "/api/session",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/recovery/request",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "retrieve recovery delivery token",
      "method": "GET",
      "path": "/api/recovery/status",
      "expect_json_true": "ok",
      "capture": {
        "reset_token": "mockDeliveryToken"
      }
    },
    {
      "name": "confirm recovery token",
      "method": "POST",
      "path": "/api/reset/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "send recovery security code",
      "method": "POST",
      "path": "/api/mfa/send",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "retrieve recovery security code",
      "method": "GET",
      "path": "/api/recovery/status",
      "expect_json_true": "ok",
      "capture": {
        "recovery_mfa_code": "mockRecoveryMfaCode"
      }
    },
    {
      "name": "confirm recovery security code",
      "method": "POST",
      "path": "/api/mfa/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${recovery_mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "change password",
      "method": "POST",
      "path": "/api/password/change",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "retrieve sign-in security code",
      "method": "GET",
      "path": "/api/login/mfa/status",
      "expect_json_true": "ok",
      "capture": {
        "login_mfa_code": "mockLoginMfaCode"
      }
    },
    {
      "name": "confirm sign-in security code",
      "method": "POST",
      "path": "/api/login/mfa/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${login_mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "sign out",
      "method": "POST",
      "path": "/api/logout",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "recovery request without CSRF rejected",
      "method": "POST",
      "path": "/api/recovery/request",
      "headers": {},
      "body": {
        "email": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "WrongPassword!2025"
      },
      "expect_failure": true
    },
    {
      "name": "privacy acceptance without authentication rejected",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_failure": true
    },
    {
      "name": "used recovery token rejected",
      "method": "POST",
      "path": "/api/reset/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${reset_token}"
      },
      "expect_failure": true
    }
  ]
}