{
  "variables": {
    "email": "helena.demo@hospital.test",
    "new_password": "NewSecure1!Pass"
  },
  "csrf": {
    "html_regex": null,
    "source_endpoint": "/api/session",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "Create session and obtain CSRF token",
      "method": "GET",
      "path": "/api/session",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "Request password recovery",
      "method": "POST",
      "path": "/api/recovery/request",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "Read recovery delivery token",
      "method": "GET",
      "path": "/api/recovery/status",
      "expect_json_true": "ok",
      "capture": {
        "recovery_token": "mockDeliveryToken"
      }
    },
    {
      "name": "Verify recovery token",
      "method": "POST",
      "path": "/api/reset/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${recovery_token}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "Send recovery MFA code",
      "method": "POST",
      "path": "/api/mfa/send",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "Read recovery MFA code",
      "method": "GET",
      "path": "/api/recovery/status",
      "expect_json_true": "ok",
      "capture": {
        "recovery_mfa_code": "mockRecoveryMfaCode"
      }
    },
    {
      "name": "Verify recovery MFA code",
      "method": "POST",
      "path": "/api/mfa/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${recovery_mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "Change password",
      "method": "POST",
      "path": "/api/password/change",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "Sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "${new_password}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "Read sign-in MFA code",
      "method": "GET",
      "path": "/api/login/mfa/status",
      "expect_json_true": "ok",
      "capture": {
        "login_mfa_code": "mockLoginMfaCode"
      }
    },
    {
      "name": "Verify sign-in MFA code",
      "method": "POST",
      "path": "/api/login/mfa/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${login_mfa_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "Accept privacy conditions",
      "method": "POST",
      "path": "/api/privacy/accept",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "Wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "password": "WrongPassword1!"
      },
      "expect_failure": true
    },
    {
      "name": "Used recovery token rejected",
      "method": "POST",
      "path": "/api/reset/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "token": "${recovery_token}"
      },
      "expect_failure": true
    },
    {
      "name": "State change without CSRF rejected",
      "method": "POST",
      "path": "/api/logout",
      "body": {},
      "expect_failure": true
    }
  ]
}