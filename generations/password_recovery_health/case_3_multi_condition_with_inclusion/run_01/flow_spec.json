{
  "variables": {
    "email": "helena@example.test",
    "new_password": "N3wSecure!Pass"
  },
  "csrf": null,
  "steps": [
    {
      "name": "open recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "load recovery session status",
      "method": "GET",
      "path": "/api/recovery-status",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/request-reset",
      "body": {
        "email": "${email}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "recovery_code": "deliveryCode"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify-reset",
      "body": {
        "token": "${recovery_code}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/reset-password",
      "body": {
        "password": "${new_password}",
        "confirm": "${new_password}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "password": "${new_password}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "code"
      }
    },
    {
      "name": "confirm MFA",
      "method": "POST",
      "path": "/api/mfa",
      "body": {
        "code": "${mfa_code}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy statement",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "password": "WrongPassword!123",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "privacy request without CSRF rejected",
      "method": "POST",
      "path": "/api/privacy",
      "body": {},
      "expect_failure": true
    },
    {
      "name": "invalid recovery code rejected",
      "method": "POST",
      "path": "/api/verify-reset",
      "body": {
        "token": "not-a-valid-recovery-code",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    }
  ]
}