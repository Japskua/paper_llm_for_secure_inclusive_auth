{
  "variables": {
    "email": "helena@example.test",
    "seeded_password": null,
    "new_password": "NewSecure!2025"
  },
  "csrf": {
    "html_regex": null,
    "field": "csrf",
    "in": "body",
    "endpoint": "/api/recovery-status"
  },
  "steps": [
    {
      "name": "load recovery page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "get session csrf token",
      "method": "GET",
      "path": "/api/recovery-status",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "request recovery code",
      "method": "POST",
      "path": "/api/request-reset",
      "body": {
        "email": "${email}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "recovery_code": "deliveryCode"
      }
    },
    {
      "name": "verify recovery code",
      "method": "POST",
      "path": "/api/verify-reset",
      "body": {
        "token": "${recovery_code}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "set new password",
      "method": "POST",
      "path": "/api/reset-password",
      "body": {
        "password": "${new_password}",
        "confirm": "${new_password}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign in with new password",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "password": "${new_password}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "mfa_code": "code"
      }
    },
    {
      "name": "confirm mfa",
      "method": "POST",
      "path": "/api/mfa",
      "body": {
        "code": "${mfa_code}",
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "accept privacy statement",
      "method": "POST",
      "path": "/api/privacy",
      "body": {
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "missing csrf rejected",
      "method": "POST",
      "path": "/api/request-reset",
      "body": {
        "email": "${email}"
      },
      "expect_failure": true
    },
    {
      "name": "invalid email rejected",
      "method": "POST",
      "path": "/api/request-reset",
      "body": {
        "email": "not-an-email",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "invalid recovery code rejected",
      "method": "POST",
      "path": "/api/verify-reset",
      "body": {
        "token": "invalid-recovery-code",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "weak password rejected",
      "method": "POST",
      "path": "/api/reset-password",
      "body": {
        "password": "weak",
        "confirm": "weak",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/login",
      "body": {
        "password": "WrongPassword!2025",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    },
    {
      "name": "wrong mfa code rejected",
      "method": "POST",
      "path": "/api/mfa",
      "body": {
        "code": "000000",
        "csrf": "${csrf}"
      },
      "expect_failure": true
    }
  ]
}