{
  "variables": {
    "email": "marcus@example.test",
    "phone": "+15551234567",
    "new_password": null
  },
  "html_variables": {},
  "csrf": {
    "html_regex": null,
    "field": "X-CSRF-Token",
    "in": "header",
    "bootstrap_path": "/api/bootstrap",
    "bootstrap_method": "GET",
    "response_field": "csrf"
  },
  "steps": [
    {
      "name": "start pre-auth session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "sign in with demo contact details",
      "method": "POST",
      "path": "/api/auth/signin",
      "body": {
        "email": "${email}",
        "phone": "${phone}"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "check MFA enrolment status",
      "method": "GET",
      "path": "/api/mfa/status",
      "expect_json_true": "ok"
    },
    {
      "name": "confirm registered identity",
      "method": "POST",
      "path": "/api/mfa/identity",
      "body": {
        "email": "${email}",
        "phone": "${phone}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "generate authenticator setup",
      "method": "POST",
      "path": "/api/mfa/setup",
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "manual_secret": "manualSecret",
        "otp": "testOtp"
      }
    },
    {
      "name": "verify authenticator and enable MFA",
      "method": "POST",
      "path": "/api/mfa/verify",
      "body": {
        "otp": "${otp}"
      },
      "expect_json_true": "ok",
      "capture": {
        "initial_recovery_code": "recoveryCodes.0"
      }
    },
    {
      "name": "view generated recovery codes",
      "method": "GET",
      "path": "/api/mfa/recovery",
      "expect_json_true": "ok",
      "capture": {
        "recovery_code": "recoveryCodes.0"
      }
    },
    {
      "name": "consume a recovery code",
      "method": "POST",
      "path": "/api/mfa/recovery/verify",
      "body": {
        "code": "${recovery_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "regenerate recovery codes",
      "method": "POST",
      "path": "/api/mfa/recovery/regenerate",
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "view regenerated recovery codes",
      "method": "GET",
      "path": "/api/mfa/recovery",
      "expect_json_true": "ok",
      "capture": {
        "regenerated_recovery_code": "recoveryCodes.0"
      }
    },
    {
      "name": "consume regenerated recovery code",
      "method": "POST",
      "path": "/api/mfa/recovery/verify",
      "body": {
        "code": "${regenerated_recovery_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign out",
      "method": "POST",
      "path": "/api/logout",
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "MFA status rejected after sign out",
      "method": "GET",
      "path": "/api/mfa/status",
      "expect_failure": true
    },
    {
      "name": "identity confirmation rejected without authenticated session",
      "method": "POST",
      "path": "/api/mfa/identity",
      "body": {
        "email": "${email}",
        "phone": "${phone}"
      },
      "expect_failure": true
    },
    {
      "name": "unknown route rejected",
      "method": "GET",
      "path": "/api/not-a-route",
      "expect_failure": true
    }
  ]
}