{
  "variables": {
    "email": "marcus.contractor@example.test",
    "phone": "+15551234567"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": null,
    "field": "X-CSRF-Token",
    "in": "header",
    "source": "JSON response field csrf from POST /api/signin"
  },
  "steps": [
    {
      "name": "load enrolment page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "request identity challenge",
      "method": "POST",
      "path": "/api/identity-challenge",
      "headers": {
        "Origin": "https://localhost:3000"
      },
      "body": {
        "email": "${email}",
        "phone": "${phone}"
      },
      "expect_json_true": "ok",
      "capture": {
        "identity_code": "mockCode"
      }
    },
    {
      "name": "sign in with identity code",
      "method": "POST",
      "path": "/api/signin",
      "headers": {
        "Origin": "https://localhost:3000"
      },
      "body": {
        "email": "${email}",
        "phone": "${phone}",
        "identityCode": "${identity_code}",
        "redirect": "setup"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "read authenticated state",
      "method": "GET",
      "path": "/api/state",
      "expect_json_true": "ok"
    },
    {
      "name": "generate authenticator setup secret",
      "method": "POST",
      "path": "/api/mfa/provision",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "authenticator_code": "mockCode"
      }
    },
    {
      "name": "verify authenticator and issue backups",
      "method": "POST",
      "path": "/api/mfa/verify-otp",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "otp": "${authenticator_code}"
      },
      "expect_json_true": "ok",
      "capture": {
        "initial_backup_code": "backupCodes.0"
      }
    },
    {
      "name": "generate replacement backup codes",
      "method": "POST",
      "path": "/api/mfa/regenerate-backup",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "replacement_backup_code": "backupCodes.0"
      }
    },
    {
      "name": "verify replacement recovery code",
      "method": "POST",
      "path": "/api/mfa/recover",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "recoveryCode": "${replacement_backup_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "log out",
      "method": "POST",
      "path": "/api/logout",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "old backup code rejected after replacement",
      "method": "POST",
      "path": "/api/mfa/recover",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "recoveryCode": "${initial_backup_code}"
      },
      "expect_failure": true
    },
    {
      "name": "authenticated action rejected after logout",
      "method": "POST",
      "path": "/api/mfa/provision",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_failure": true
    },
    {
      "name": "wrong identity code rejected",
      "method": "POST",
      "path": "/api/signin",
      "headers": {
        "Origin": "https://localhost:3000"
      },
      "body": {
        "email": "${email}",
        "phone": "${phone}",
        "identityCode": "000000",
        "redirect": "setup"
      },
      "expect_failure": true
    }
  ]
}