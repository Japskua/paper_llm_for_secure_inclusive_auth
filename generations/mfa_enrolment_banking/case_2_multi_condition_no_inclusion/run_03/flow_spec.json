{
  "variables": {
    "email": "marcus@example.test",
    "password": "NorthstarDemo!54",
    "new_password": "NorthstarNew!55"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": null,
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "load MFA enrolment page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "bootstrap anonymous session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "sign in with approved account",
      "method": "POST",
      "path": "/api/auth/signin",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "phone": "",
        "password": "${password}",
        "destination": "/"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf",
        "identityCode": "testCode"
      }
    },
    {
      "name": "verify identity code",
      "method": "POST",
      "path": "/api/auth/identity",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${identityCode}"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "start authenticator setup",
      "method": "POST",
      "path": "/api/mfa/begin",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf",
        "totpCode": "testCode"
      }
    },
    {
      "name": "confirm authenticator",
      "method": "POST",
      "path": "/api/mfa/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${totpCode}"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf",
        "initialRecoveryCode": "codes.0"
      }
    },
    {
      "name": "check MFA status",
      "method": "GET",
      "path": "/api/mfa/status",
      "expect_json_true": "ok"
    },
    {
      "name": "use initial recovery code",
      "method": "POST",
      "path": "/api/backup/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${initialRecoveryCode}"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "generate replacement recovery codes",
      "method": "POST",
      "path": "/api/backup/regenerate",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf",
        "replacementRecoveryCode": "codes.0"
      }
    },
    {
      "name": "use replacement recovery code",
      "method": "POST",
      "path": "/api/backup/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${replacementRecoveryCode}"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "log out",
      "method": "POST",
      "path": "/api/logout",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "bootstrap fresh negative-test session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "wrong password still receives nonrevealing challenge",
      "method": "POST",
      "path": "/api/auth/signin",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "phone": "",
        "password": "WrongPassword!54",
        "destination": "/"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf",
        "wrongPasswordIdentityCode": "testCode"
      }
    },
    {
      "name": "wrong password cannot complete identity verification",
      "method": "POST",
      "path": "/api/auth/identity",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${wrongPasswordIdentityCode}"
      },
      "expect_failure": true
    },
    {
      "name": "missing CSRF token rejected",
      "method": "POST",
      "path": "/api/auth/signin",
      "headers": {},
      "body": {
        "email": "${email}",
        "phone": "",
        "password": "${password}",
        "destination": "/"
      },
      "expect_failure": true
    }
  ]
}