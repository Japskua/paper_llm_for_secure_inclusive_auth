{
  "variables": {
    "email": "marcus@example.test",
    "new_password": "NewPass!9"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": "(?!)",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "create pre-auth session and fetch CSRF token",
      "method": "GET",
      "path": "/api/csrf",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "sign in",
      "method": "POST",
      "path": "/api/signin",
      "body": {
        "email": "${email}",
        "password": "BankPass!9"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "send identity verification code",
      "method": "POST",
      "path": "/api/identity/send",
      "body": {
        "phone": "+15551234567"
      },
      "expect_json_true": "ok",
      "capture": {
        "identity_code": "mockCode"
      }
    },
    {
      "name": "verify identity",
      "method": "POST",
      "path": "/api/identity/verify",
      "body": {
        "code": "${identity_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "provision authenticator",
      "method": "POST",
      "path": "/api/mfa/provision",
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "authenticator_secret": "secret",
        "authenticator_otp": "mockOtp"
      }
    },
    {
      "name": "enable MFA",
      "method": "POST",
      "path": "/api/mfa/verify",
      "body": {
        "otp": "${authenticator_otp}",
        "manualSecret": ""
      },
      "expect_json_true": "ok",
      "capture": {
        "recovery_code": "codes.0"
      }
    },
    {
      "name": "check MFA status",
      "method": "GET",
      "path": "/api/mfa/status",
      "expect_json_true": "ok"
    },
    {
      "name": "use recovery code",
      "method": "POST",
      "path": "/api/mfa/recovery/verify",
      "body": {
        "recoveryCode": "${recovery_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "regenerate recovery codes",
      "method": "POST",
      "path": "/api/mfa/recovery/regenerate",
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "regenerated_recovery_code": "codes.0"
      }
    },
    {
      "name": "verify regenerated recovery code",
      "method": "POST",
      "path": "/api/mfa/recovery/verify",
      "body": {
        "recoveryCode": "${regenerated_recovery_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "log out",
      "method": "POST",
      "path": "/api/logout",
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/signin",
      "body": {
        "email": "marcus@example.test",
        "password": "WrongPass!9"
      },
      "expect_failure": true
    },
    {
      "name": "invalid authenticator code rejected",
      "method": "POST",
      "path": "/api/mfa/verify",
      "body": {
        "otp": "000000",
        "manualSecret": ""
      },
      "expect_failure": true
    },
    {
      "name": "malformed recovery code rejected",
      "method": "POST",
      "path": "/api/mfa/recovery/verify",
      "body": {
        "recoveryCode": "INVALID"
      },
      "expect_failure": true
    }
  ]
}