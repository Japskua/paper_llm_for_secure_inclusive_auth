{
  "variables": {
    "email": "marcus@example.com",
    "phone": "+15551234567"
  },
  "html_variables": {},
  "csrf": {
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "create bootstrap session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "start identity verification",
      "method": "POST",
      "path": "/api/signin",
      "body": {
        "email": "${email}",
        "phone": "${phone}",
        "redirect": "/#verify"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf",
        "identity_code": "testCode"
      }
    },
    {
      "name": "verify identity code",
      "method": "POST",
      "path": "/api/identity/verify",
      "body": {
        "otp": "${identity_code}",
        "redirect": "/#setup"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "confirm authenticated session",
      "method": "GET",
      "path": "/api/me",
      "expect_json_true": "ok"
    },
    {
      "name": "start authenticator setup",
      "method": "POST",
      "path": "/api/authenticator/start",
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "provisioning_secret": "provisioningSecret",
        "authenticator_otp": "testOtp"
      }
    },
    {
      "name": "verify authenticator",
      "method": "POST",
      "path": "/api/authenticator/verify",
      "body": {
        "secret": "${provisioning_secret}",
        "otp": "${authenticator_otp}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "generate recovery codes",
      "method": "POST",
      "path": "/api/backup/generate",
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "recovery_code": "codes.0"
      }
    },
    {
      "name": "confirm recovery codes stored",
      "method": "POST",
      "path": "/api/backup/confirm",
      "body": {
        "acknowledged": true
      },
      "expect_json_true": "mfaEnabled"
    },
    {
      "name": "redeem a recovery code",
      "method": "POST",
      "path": "/api/recovery/redeem",
      "body": {
        "code": "${recovery_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "confirm MFA is active",
      "method": "GET",
      "path": "/api/me",
      "expect_json_true": "mfaEnabled"
    },
    {
      "name": "sign out",
      "method": "POST",
      "path": "/api/logout",
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "malformed phone is rejected",
      "method": "POST",
      "path": "/api/signin",
      "body": {
        "email": "${email}",
        "phone": "not-a-phone",
        "redirect": "/#verify"
      },
      "expect_failure": true
    },
    {
      "name": "wrong identity code is rejected",
      "method": "POST",
      "path": "/api/identity/verify",
      "body": {
        "otp": "000000",
        "redirect": "/#setup"
      },
      "expect_failure": true
    },
    {
      "name": "authenticated session is unavailable after logout",
      "method": "GET",
      "path": "/api/me",
      "expect_failure": true
    }
  ]
}