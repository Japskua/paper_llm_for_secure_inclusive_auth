{
  "variables": {
    "email": "marcus@example.com",
    "new_password": null
  },
  "html_variables": {},
  "csrf": {
    "html_regex": null,
    "field": "X-CSRF-Token",
    "in": "header",
    "source_path": "/api/bootstrap",
    "source_field": "csrf"
  },
  "steps": [
    {
      "name": "load MFA setup page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "mock sign in as Marcus",
      "method": "POST",
      "path": "/api/mock/login",
      "headers": {
        "Origin": "https://localhost:3000"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "bootstrap authenticated setup session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "send identity verification code",
      "method": "POST",
      "path": "/api/identity/send",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "phone": "4821"
      },
      "expect_json_true": "ok",
      "capture": {
        "identity_code": "mockCode"
      }
    },
    {
      "name": "verify identity code",
      "method": "POST",
      "path": "/api/identity/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${identity_code}"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "create authenticator setup key",
      "method": "POST",
      "path": "/api/provision",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "setup_secret": "secret",
        "authenticator_uri": "uri",
        "mock_otp": "mockOtp"
      }
    },
    {
      "name": "get current authenticator code",
      "method": "POST",
      "path": "/api/totp/mock",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "mock_otp": "mockOtp"
      }
    },
    {
      "name": "verify authenticator code",
      "method": "POST",
      "path": "/api/otp/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${mock_otp}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "generate backup codes",
      "method": "POST",
      "path": "/api/backups/generate",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "backup_code": "codes.0"
      }
    },
    {
      "name": "complete MFA enrollment",
      "method": "POST",
      "path": "/api/complete",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "use one backup recovery code",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${backup_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "log out safely",
      "method": "POST",
      "path": "/api/logout",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "invalid backup code rejected",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "FFFF-FFFF-FFFF-FFFF"
      },
      "expect_failure": true
    },
    {
      "name": "used backup code rejected",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${backup_code}"
      },
      "expect_failure": true
    },
    {
      "name": "bootstrap rejected after logout",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_failure": true
    }
  ]
}