\') + \\\'.\\\' + Buffer.from(encrypted).toString(\\\'base64url\\\');\\n}\\nfunction cookie(name: string, value: string, extra = \\\'\\\') { return ${name}=${value}; Path=/; HttpOnly; Secure; SameSite=Strict; ${extra}; }\\nfunction headers(extra: Record<string, string> = {}) {\\n  return { \\\'Content-Type\\\': \\\'application/json; charset=utf-8\\\', \\\'Content-Security-Policy\\\': "default-src \\\'self\\\'; style-src \\\'self\\\' \\\'unsafe-inline\\\'; script-src \\\'self\\\' \\\'unsafe-inline\\\'; img-src \\\'self\\\' data:; base-uri \\\'none\\\'; form-action \\\'self\\\'; frame-ancestors \\\'none\\\'", \\\'Strict-Transport-Security\\\': \\\'max-age=31536000; includeSubDomains\\\', \\\'X-Content-Type-Options\\\': \\\'nosniff\\\', \\\'X-Frame-Options\\\': \\\'DENY\\\', \\\'Referrer-Policy\\\': \\\'no-referrer\\\', \\\'Access-Control-Allow-Origin\\\': trustedOrigin, \\\'Vary\\\': \\\'Origin\\\', ...extra };\\n}\\nfunction json(data: unknown, status = 200, extra: Record<string, string> = {}) { return new Response(JSON.stringify(data), { status, headers: headers(extra) }); }\\nfunction getCookie(req: Request, name: string) { return (req.headers.get(\\\'cookie\\\') || \\\'\\\').split(\\\';\\\').map(x => x.trim()).find(x => x.startsWith(name + \\\'=\\\'))?.slice(name.length + 1); }\\nfunction requireSession(req: Request) {\\n  const id = getCookie(req, \\\'sid\\\'); const s = id && sessions.get(id); const now = Date.now();\\n  if (!s || now - s.lastSeen > SESSION_IDLE_MS || now - s.created > SESSION_ABSOLUTE_MS) { if (id) sessions.delete(id); return null; }\\n  s.lastSeen = now; return { id, s };\\n}\\nasync function body(req: Request) { try { return await req.json() as Record<string, unknown>; } catch { return {}; } }\\nfunction validCsrf(req: Request, s: { csrf: string }) { return req.headers.get(\\\'x-csrf-token\\\') === s.csrf; }\\nfunction code() { return String(crypto.getRandomValues(new Uint32Array(1))[0] % 1_000_000).padStart(6, \\\'0\\\'); }\\nfunction backups() { return Array.from({ length: 8 }, () => token(9).toUpperCase()); }\\nfunction appHtml() { return <!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SecureBank MFA</title><style>\\n:root{font-family:Verdana,Arial,sans-serif;color:#14213d;background:#f5f8fc;letter-spacing:.035em;line-height:1.65}body{margin:0}.wrap{max-width:520px;margin:auto;padding:22px}.card{background:#fff;border-radius:16px;padding:24px;box-shadow:0 2px 12px #14213d18}h1{font-size:1.55rem;line-height:1.3;margin:0 0 8px}h2{font-size:1.25rem}p{margin:10px 0}.step{color:#315b96;font-weight:bold}.icon{font-size:2rem}label{display:block;font-weight:bold;margin-top:14px}input{box-sizing:border-box;width:100%;font:inherit;letter-spacing:.12em;padding:13px;border:2px solid #65758b;border-radius:9px}button{width:100%;font:inherit;font-weight:bold;padding:14px;margin-top:18px;background:#075bb5;color:white;border:0;border-radius:9px;cursor:pointer}button.secondary{background:white;color:#075bb5;border:2px solid #075bb5}.hint,.notice{padding:12px;border-radius:9px}.hint{background:#edf4ff}.notice{background:#e7f7ed}.error{background:#ffe9e9;color:#7a1717}.codes{letter-spacing:.08em;word-break:break-all;background:#f3f6fa;padding:12px;border-radius:8px}a{color:#075bb5}small{display:block;margin-top:12px}@media(max-width:400px){.wrap{padding:12px}.card{padding:18px}}\\n</style></head><body><main class="wrap"><section class="card" aria-live="polite" id="app"></section></main><script>\\n// Inclusivity: short plain-language screens, generous spacing, no timers/animation, explicit errors, and copy buttons.\\n// Requirement: browser-only mock delivery is displayed solely through console.log; no local/session storage is used.\\nlet csrf=\\\'\\\', secret=\\\'\\\', recovery=[]; const app=document.getElementById(\\\'app\\\');\\nconst esc=s=>String(s).replace(/[&<>\\\\"\\\']/g,c=>({\\\'&\\\':\\\'&amp;\\\',\\\'<\\\':\\\'&lt;\\\',\\\'>