{
  "variables": {
    "date_of_birth": "14 June 1971",
    "account_ending": "4821"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": null,
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "load MFA enrolment page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "confirm Marcus identity and create session",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "Origin": "https://localhost:3000"
      },
      "body": {
        "dateOfBirth": "${date_of_birth}",
        "accountEnding": "${account_ending}"
      },
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "provision authenticator",
      "method": "POST",
      "path": "/api/mfa/provision",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "capture": {
        "mock_otp": "mockOtp"
      }
    },
    {
      "name": "verify authenticator code",
      "method": "POST",
      "path": "/api/mfa/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "otp": "${mock_otp}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "create recovery codes",
      "method": "POST",
      "path": "/api/mfa/backup-codes",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "capture": {
        "recovery_code": "codes.0"
      }
    },
    {
      "name": "use one recovery code",
      "method": "POST",
      "path": "/api/mfa/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${recovery_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "regenerate recovery codes",
      "method": "POST",
      "path": "/api/mfa/backup-codes/regenerate",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "capture": {
        "replacement_recovery_code": "codes.0"
      }
    },
    {
      "name": "sign out",
      "method": "POST",
      "path": "/api/logout",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "wrong identity details rejected",
      "method": "POST",
      "path": "/api/login",
      "headers": {
        "Origin": "https://localhost:3000"
      },
      "body": {
        "dateOfBirth": "14 June 1971",
        "accountEnding": "0000"
      },
      "expect_failure": true
    },
    {
      "name": "provision without CSRF token rejected",
      "method": "POST",
      "path": "/api/mfa/provision",
      "headers": {
        "Origin": "https://localhost:3000"
      },
      "body": {},
      "expect_failure": true
    },
    {
      "name": "incorrect authenticator code rejected",
      "method": "POST",
      "path": "/api/mfa/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "otp": "000000"
      },
      "expect_failure": true
    },
    {
      "name": "malformed recovery code rejected",
      "method": "POST",
      "path": "/api/mfa/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "not-a-code"
      },
      "expect_failure": true
    }
  ]
}