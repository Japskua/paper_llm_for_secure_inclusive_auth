{
  "variables": {
    "email": "marcus@example.test",
    "new_password": "not-applicable"
  },
  "html_variables": {},
  "csrf": null,
  "steps": [
    {
      "name": "load security setup page",
      "method": "GET",
      "path": "/"
    },
    {
      "name": "start sign-in",
      "method": "POST",
      "path": "/api/auth/signin",
      "body": {
        "email": "${email}"
      },
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "send owner approval code",
      "method": "POST",
      "path": "/api/auth/owner",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "capture": {
        "owner_code": "testCode"
      }
    },
    {
      "name": "verify owner approval and receive identity code",
      "method": "POST",
      "path": "/api/auth/owner/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${owner_code}"
      },
      "capture": {
        "csrf": "csrf",
        "identity_code": "testCode"
      }
    },
    {
      "name": "verify identity code",
      "method": "POST",
      "path": "/api/identity/verify",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${identity_code}"
      }
    },
    {
      "name": "obtain authenticator provisioning data",
      "method": "POST",
      "path": "/api/mfa/provision",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "capture": {
        "totp_secret": "secret",
        "totp_uri": "uri"
      }
    }
  ],
  "negative_steps": [
    {
      "name": "unknown email rejected",
      "method": "POST",
      "path": "/api/auth/signin",
      "body": {
        "email": "unknown@example.test"
      },
      "expect_failure": true
    },
    {
      "name": "owner-code request without CSRF rejected",
      "method": "POST",
      "path": "/api/auth/owner",
      "body": {},
      "expect_failure": true
    },
    {
      "name": "recovery-code generation before MFA verification rejected",
      "method": "POST",
      "path": "/api/mfa/recovery/generate",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_failure": true
    }
  ],
  "testability_issue": {
    "blocking_route": "/api/mfa/totp/verify",
    "required_body_field": "code",
    "reason": "The application requires a six-digit TOTP derived from the provisioned shared secret, but no route returns a mock/current authenticator code. The only available fields are secret and uri from /api/mfa/provision. Under the stated rule that the test client must not compute TOTP values, the happy path cannot proceed beyond provisioning, so recovery generation, regeneration, and recovery-code sign-in cannot be automated from this server API."
  }
}