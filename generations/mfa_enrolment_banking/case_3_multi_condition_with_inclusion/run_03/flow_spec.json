{
  "variables": {
    "email": "marcus@example.com",
    "password": "MarcusSecure!54",
    "new_password": "NewSecure!54"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": "let csrf=\"([^\"]+)\"",
    "field": "X-CSRF-Token",
    "in": "header"
  },
  "steps": [
    {
      "name": "sign in",
      "method": "POST",
      "path": "/api/sign-in",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "${password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "session_csrf": "csrf"
      }
    },
    {
      "name": "request identity code",
      "method": "POST",
      "path": "/api/identity/request",
      "headers": {
        "X-CSRF-Token": "${session_csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "identity_code": "mockIdentityCode"
      }
    },
    {
      "name": "verify identity",
      "method": "POST",
      "path": "/api/identity/verify",
      "headers": {
        "X-CSRF-Token": "${session_csrf}"
      },
      "body": {
        "code": "${identity_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "prepare authenticator",
      "method": "POST",
      "path": "/api/authenticator/setup",
      "headers": {
        "X-CSRF-Token": "${session_csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "authenticator_code": "mockTotpCode"
      }
    },
    {
      "name": "confirm authenticator",
      "method": "POST",
      "path": "/api/authenticator/verify",
      "headers": {
        "X-CSRF-Token": "${session_csrf}"
      },
      "body": {
        "code": "${authenticator_code}"
      },
      "expect_json_true": "ok",
      "capture": {
        "original_recovery_code": "recoveryCodes.0"
      }
    },
    {
      "name": "regenerate recovery codes",
      "method": "POST",
      "path": "/api/recovery/regenerate",
      "headers": {
        "X-CSRF-Token": "${session_csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "replacement_recovery_code": "recoveryCodes.0"
      }
    },
    {
      "name": "acknowledge saved recovery codes",
      "method": "POST",
      "path": "/api/recovery/acknowledge",
      "headers": {
        "X-CSRF-Token": "${session_csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/sign-in",
      "headers": {
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "WrongPassword!54"
      },
      "expect_failure": true
    },
    {
      "name": "replaced recovery code rejected",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "X-CSRF-Token": "${session_csrf}"
      },
      "body": {
        "code": "${original_recovery_code}"
      },
      "expect_failure": true
    },
    {
      "name": "missing csrf rejected",
      "method": "POST",
      "path": "/api/recovery/acknowledge",
      "body": {},
      "expect_failure": true
    }
  ]
}