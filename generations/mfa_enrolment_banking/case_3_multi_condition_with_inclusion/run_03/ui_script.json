{
  "variables": {
    "email": "marcus@example.com",
    "new_password": "NewSecure!54"
  },
  "steps": [
    {
      "name": "login_page",
      "actions": []
    },
    {
      "name": "sign_in",
      "actions": [
        {
          "do": "fill",
          "selector": "#email",
          "value": "${email}"
        },
        {
          "do": "fill",
          "selector": "#password",
          "value": "MarcusSecure!54"
        },
        {
          "do": "click",
          "selector": "button:has-text('Sign in and continue')"
        },
        {
          "do": "wait_for",
          "selector": "text=Check it is you"
        }
      ]
    },
    {
      "name": "request_identity_code",
      "actions": [
        {
          "do": "click",
          "selector": "#request"
        },
        {
          "do": "wait_for",
          "selector": "#verify"
        },
        {
          "do": "read",
          "selector": "#logs",
          "regex": "Mock identity code:\\s*(\\d{6})",
          "into": "identity_code"
        }
      ]
    },
    {
      "name": "verify_identity_code",
      "actions": [
        {
          "do": "fill",
          "selector": "#otp",
          "value": "${identity_code}"
        },
        {
          "do": "click",
          "selector": "#verify button"
        },
        {
          "do": "wait_for",
          "selector": "text=Connect your authenticator"
        }
      ]
    },
    {
      "name": "prepare_authenticator_details",
      "actions": [
        {
          "do": "click",
          "selector": "#prepare"
        },
        {
          "do": "wait_for",
          "selector": "#auth-form"
        },
        {
          "do": "read",
          "selector": "#logs",
          "regex": "Mock current TOTP:\\s*(\\d{6})",
          "into": "authenticator_code"
        }
      ]
    },
    {
      "name": "confirm_authenticator",
      "actions": [
        {
          "do": "fill",
          "selector": "#auth-form #otp",
          "value": "${authenticator_code}"
        },
        {
          "do": "click",
          "selector": "#auth-form button"
        },
        {
          "do": "wait_for",
          "selector": "text=Save your recovery codes"
        }
      ]
    },
    {
      "name": "regenerate_recovery_codes",
      "actions": [
        {
          "do": "click",
          "selector": "#regenerate"
        },
        {
          "do": "wait_for",
          "selector": "text=New current recovery codes were generated"
        }
      ]
    },
    {
      "name": "acknowledge_saved_recovery_codes",
      "actions": [
        {
          "do": "click",
          "selector": "#saved"
        },
        {
          "do": "wait_for",
          "selector": "text=MFA is ready"
        }
      ]
    }
  ]
}