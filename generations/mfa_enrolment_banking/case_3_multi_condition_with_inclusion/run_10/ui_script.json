{
  "variables": {
    "email": "marcus@example.test",
    "new_password": "Northstar-55"
  },
  "steps": [
    {
      "name": "login_page",
      "actions": []
    },
    {
      "name": "identity_check",
      "actions": [
        {
          "do": "fill",
          "selector": "input[type='email']",
          "value": "${email}"
        },
        {
          "do": "fill",
          "selector": "input[type='password']",
          "value": "Northstar-54"
        },
        {
          "do": "click",
          "selector": "button:has-text('Continue')"
        }
      ]
    },
    {
      "name": "verify_identity_code",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Send my check code')"
        },
        {
          "do": "read",
          "selector": "#logs",
          "regex": "SIMULATED IDENTITY DELIVERY[\\s\\S]*?valid code: (\\d{6})",
          "into": "identity_code"
        },
        {
          "do": "fill",
          "selector": "input[autocomplete='one-time-code']",
          "value": "${identity_code}"
        }
      ]
    },
    {
      "name": "authenticator_setup_intro",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Check code')"
        }
      ]
    },
    {
      "name": "scan_setup_code",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Show setup details')"
        }
      ]
    },
    {
      "name": "verify_authenticator_code",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('I added it to my app')"
        },
        {
          "do": "read",
          "selector": "#logs",
          "regex": "\"validTestCode\":\"(\\d{6})\"",
          "into": "authenticator_code"
        },
        {
          "do": "fill",
          "selector": "input[autocomplete='one-time-code']",
          "value": "${authenticator_code}"
        }
      ]
    },
    {
      "name": "save_recovery_codes",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Finish authenticator setup')"
        }
      ]
    },
    {
      "name": "view_initial_recovery_codes",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Show recovery codes')"
        }
      ]
    },
    {
      "name": "regenerate_recovery_codes",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Make new codes')"
        }
      ]
    },
    {
      "name": "save_regenerated_recovery_codes",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Show recovery codes')"
        },
        {
          "do": "read",
          "selector": "#logs",
          "regex": "REGENERATED RECOVERY CODES: \\[\"([A-F0-9]{10}-[A-F0-9]{10})\"",
          "into": "recovery_code"
        }
      ]
    },
    {
      "name": "security_summary",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('I saved my codes')"
        }
      ]
    },
    {
      "name": "use_recovery_code",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Use a recovery code')"
        },
        {
          "do": "fill",
          "selector": "input[autocomplete='one-time-code']",
          "value": "${recovery_code}"
        }
      ]
    },
    {
      "name": "recovery_code_accepted",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Use recovery code')"
        }
      ]
    },
    {
      "name": "security_summary_returned",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Return to security summary')"
        }
      ]
    },
    {
      "name": "signed_out_login_page",
      "actions": [
        {
          "do": "click",
          "selector": "button:has-text('Sign out')"
        }
      ]
    }
  ]
}