{
  "variables": {
    "email": "marcus@example.test",
    "new_password": "Northstar-55"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": null,
    "field": "x-csrf-token",
    "in": "header",
    "source_step": "authenticate",
    "response_field": "csrf"
  },
  "steps": [
    {
      "name": "obtain login CSRF token",
      "method": "GET",
      "path": "/api/login-csrf",
      "capture": {
        "login_csrf": "token"
      }
    },
    {
      "name": "sign in with seeded account",
      "method": "POST",
      "path": "/api/authenticate",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-Login-CSRF-Token": "${login_csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "Northstar-54"
      },
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "request identity check code",
      "method": "POST",
      "path": "/api/identity/request",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "capture": {
        "identity_code": "deliveredCode"
      }
    },
    {
      "name": "verify identity check code",
      "method": "POST",
      "path": "/api/identity/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${identity_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "start authenticator setup",
      "method": "POST",
      "path": "/api/authenticator/setup",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "capture": {
        "authenticator_code": "testCode"
      }
    },
    {
      "name": "verify authenticator code",
      "method": "POST",
      "path": "/api/authenticator/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${authenticator_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "regenerate recovery codes",
      "method": "POST",
      "path": "/api/recovery/regenerate",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "capture": {
        "recovery_code": "recoveryCodes.0"
      }
    },
    {
      "name": "confirm recovery codes saved",
      "method": "POST",
      "path": "/api/recovery/confirm",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "use one recovery code",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${recovery_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign out",
      "method": "POST",
      "path": "/api/logout",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "used recovery code rejected",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${recovery_code}"
      },
      "expect_failure": true
    },
    {
      "name": "obtain fresh login CSRF token for failed login",
      "method": "GET",
      "path": "/api/login-csrf",
      "capture": {
        "negative_login_csrf": "token"
      }
    },
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/authenticate",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-Login-CSRF-Token": "${negative_login_csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "Wrong-password-00"
      },
      "expect_failure": true
    }
  ]
}