{
  "variables": {
    "email": "marcus@example.com",
    "password": "bank-demo"
  },
  "html_variables": {},
  "csrf": null,
  "steps": [
    {
      "name": "bootstrap secure session",
      "method": "GET",
      "path": "/api/bootstrap",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "sign in with demo account",
      "method": "POST",
      "path": "/api/sign-in",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "${password}"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf",
        "identity_code": "identityCode"
      }
    },
    {
      "name": "verify identity",
      "method": "POST",
      "path": "/api/identity/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "phone": "+1 555 010 0200",
        "code": "${identity_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "show authenticator setup",
      "method": "POST",
      "path": "/api/authenticator/setup",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok",
      "capture": {
        "authenticator_otp": "authenticatorOtp"
      }
    },
    {
      "name": "confirm authenticator",
      "method": "POST",
      "path": "/api/otp/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "code": "${authenticator_otp}"
      },
      "expect_json_true": "ok",
      "capture": {
        "recovery_code": "recoveryCodes.0"
      }
    },
    {
      "name": "complete recovery code saving",
      "method": "POST",
      "path": "/api/recovery/complete",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    },
    {
      "name": "test a recovery code",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "recoveryCode": "${recovery_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign out safely",
      "method": "POST",
      "path": "/api/logout",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {},
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/sign-in",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "email": "${email}",
        "password": "bank-demo-wrong"
      },
      "expect_failure": true
    },
    {
      "name": "invalid csrf token rejected",
      "method": "POST",
      "path": "/api/sign-in",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "invalid"
      },
      "body": {
        "email": "${email}",
        "password": "${password}"
      },
      "expect_failure": true
    },
    {
      "name": "used recovery code rejected",
      "method": "POST",
      "path": "/api/recovery/verify",
      "headers": {
        "Origin": "https://localhost:3000",
        "X-CSRF-Token": "${csrf}"
      },
      "body": {
        "recoveryCode": "${recovery_code}"
      },
      "expect_failure": true
    }
  ]
}