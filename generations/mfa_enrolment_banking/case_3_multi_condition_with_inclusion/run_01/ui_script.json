{
  "variables": {
    "email": "marcus@example.test",
    "credential": "Harbour-demo-54",
    "new_password": "NewPass-2025"
  },
  "steps": [
    {
      "name": "login_page",
      "actions": []
    },
    {
      "name": "identity_check",
      "actions": [
        {
          "do": "fill",
          "selector": "#email",
          "value": "${email}"
        },
        {
          "do": "fill",
          "selector": "#credential",
          "value": "${credential}"
        },
        {
          "do": "click",
          "selector": "button:has-text('Continue')"
        },
        {
          "do": "wait_for",
          "selector": "#identity"
        }
      ]
    },
    {
      "name": "authenticator_setup_hidden",
      "actions": [
        {
          "do": "click",
          "selector": "#fillI"
        },
        {
          "do": "click",
          "selector": "button:has-text('Check code')"
        },
        {
          "do": "wait_for",
          "selector": "#show"
        }
      ]
    },
    {
      "name": "authenticator_setup_details",
      "actions": [
        {
          "do": "click",
          "selector": "#show"
        },
        {
          "do": "wait_for",
          "selector": "#toOtp"
        }
      ]
    },
    {
      "name": "confirm_authenticator",
      "actions": [
        {
          "do": "click",
          "selector": "#toOtp"
        },
        {
          "do": "wait_for",
          "selector": "#otp"
        }
      ]
    },
    {
      "name": "save_recovery_codes",
      "actions": [
        {
          "do": "click",
          "selector": "#fillO"
        },
        {
          "do": "click",
          "selector": "button:has-text('Confirm authenticator')"
        },
        {
          "do": "wait_for",
          "selector": ".code-list li"
        },
        {
          "do": "read",
          "selector": ".code-list li",
          "regex": "^([A-Z2-9]{5}-[A-Z2-9]{5})$",
          "into": "recovery_code"
        }
      ]
    },
    {
      "name": "security_settings",
      "actions": [
        {
          "do": "click",
          "selector": "#saved"
        },
        {
          "do": "click",
          "selector": "#finish"
        },
        {
          "do": "wait_for",
          "selector": "#recovery"
        }
      ]
    },
    {
      "name": "recovery_code_tested",
      "actions": [
        {
          "do": "fill",
          "selector": "#recovery",
          "value": "${recovery_code}"
        },
        {
          "do": "click",
          "selector": "#test"
        }
      ]
    },
    {
      "name": "replacement_recovery_codes",
      "actions": [
        {
          "do": "click",
          "selector": "#regen"
        },
        {
          "do": "wait_for",
          "selector": ".code-list li"
        }
      ]
    },
    {
      "name": "replacement_codes_confirmed",
      "actions": [
        {
          "do": "click",
          "selector": "#saved"
        },
        {
          "do": "click",
          "selector": "#finish"
        },
        {
          "do": "wait_for",
          "selector": "#logout"
        }
      ]
    },
    {
      "name": "signed_out",
      "actions": [
        {
          "do": "click",
          "selector": "#logout"
        },
        {
          "do": "wait_for",
          "selector": "#email"
        }
      ]
    }
  ]
}