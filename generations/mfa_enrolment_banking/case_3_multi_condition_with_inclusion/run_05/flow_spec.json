{
  "variables": {
    "email": "marcus@example.com",
    "new_password": "ValidNewPassword!54"
  },
  "html_variables": {},
  "csrf": {
    "html_regex": null,
    "field": "csrf",
    "in": "body"
  },
  "steps": [
    {
      "name": "create CSRF session",
      "method": "GET",
      "path": "/api/csrf",
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf"
      }
    },
    {
      "name": "sign in demo account",
      "method": "POST",
      "path": "/api/signin",
      "body": {
        "csrf": "${csrf}",
        "email": "${email}",
        "password": "MarcusDemo!54"
      },
      "expect_json_true": "ok",
      "capture": {
        "csrf": "csrf",
        "identity_code": "testValues.identityCode"
      }
    },
    {
      "name": "verify identity code",
      "method": "POST",
      "path": "/api/identity/verify",
      "body": {
        "csrf": "${csrf}",
        "code": "${identity_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "provision authenticator",
      "method": "POST",
      "path": "/api/provision",
      "body": {
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "setup_secret": "secret"
      }
    },
    {
      "name": "confirm authenticator setup",
      "method": "POST",
      "path": "/api/provision/manual",
      "body": {
        "csrf": "${csrf}",
        "secret": "${setup_secret}"
      },
      "expect_json_true": "ok",
      "capture": {
        "authenticator_otp": "testValues.authenticatorOtp"
      }
    },
    {
      "name": "verify authenticator code",
      "method": "POST",
      "path": "/api/otp/verify",
      "body": {
        "csrf": "${csrf}",
        "code": "${authenticator_otp}"
      },
      "expect_json_true": "ok",
      "capture": {
        "backup_code": "recoveryCodes.0",
        "backup_code_to_use": "recoveryCodes.1"
      }
    },
    {
      "name": "confirm backup code saved",
      "method": "POST",
      "path": "/api/recovery/confirm",
      "body": {
        "csrf": "${csrf}",
        "code": "${backup_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "use backup code",
      "method": "POST",
      "path": "/api/recovery/use",
      "body": {
        "csrf": "${csrf}",
        "code": "${backup_code_to_use}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "regenerate backup codes",
      "method": "POST",
      "path": "/api/recovery/regenerate",
      "body": {
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok",
      "capture": {
        "replacement_backup_code": "recoveryCodes.0"
      }
    },
    {
      "name": "confirm replacement backup code",
      "method": "POST",
      "path": "/api/recovery/confirm",
      "body": {
        "csrf": "${csrf}",
        "code": "${replacement_backup_code}"
      },
      "expect_json_true": "ok"
    },
    {
      "name": "sign out",
      "method": "POST",
      "path": "/api/logout",
      "body": {
        "csrf": "${csrf}"
      },
      "expect_json_true": "ok"
    }
  ],
  "negative_steps": [
    {
      "name": "wrong password rejected",
      "method": "POST",
      "path": "/api/signin",
      "body": {
        "csrf": "${csrf}",
        "email": "${email}",
        "password": "WrongPassword!54"
      },
      "expect_failure": true
    },
    {
      "name": "malformed identity code rejected",
      "method": "POST",
      "path": "/api/identity/verify",
      "body": {
        "csrf": "${csrf}",
        "code": "12345"
      },
      "expect_failure": true
    },
    {
      "name": "invalid authenticator code rejected",
      "method": "POST",
      "path": "/api/otp/verify",
      "body": {
        "csrf": "${csrf}",
        "code": "000000"
      },
      "expect_failure": true
    },
    {
      "name": "invalid backup code rejected",
      "method": "POST",
      "path": "/api/recovery/use",
      "body": {
        "csrf": "${csrf}",
        "code": "AAAAA-AAAAA"
      },
      "expect_failure": true
    }
  ]
}